# Copia este archivo como ".env" y completa tus valores reales

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gestion_cuentas
DB_USER=postgres
DB_PASSWORD=tu_password

# Servidor
PORT=3000

# Seguridad (usa una cadena larga y aleatoria en produccion)
JWT_SECRET=cambia_esto_por_una_clave_secreta_larga

# ---- WhatsApp (Meta Cloud API) ----
# Mientras no tengas estas credenciales, deja WHATSAPP_MODE=simulado
# El sistema funcionara igual, solo que los mensajes se veran en la consola
# en vez de enviarse de verdad.
WHATSAPP_MODE=simulado
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Usuario Super Admin inicial (se crea la primera vez que corres db:setup)
SUPERADMIN_EMAIL=admin@tucorreo.com
SUPERADMIN_PASSWORD=CambiaEstaClave123
